{
  "name": "portal-core",
  "version": "4.4.8",
  "overrides": {
    "ajv": "^8.18.0",
    "browserslist": "4.29.3",
    "fast-uri": "4.2.2",
    "magic-string": "0.30.21",
    "picomatch@4": "4.0.5",
    "@vitest/ui": "npm:@vitest/utils@4.1.11"
  },
  "scripts": {
    "ng": "ng",
    "clean": "rimraf dist",
    "postinstall": "npm run build:schematics",
    "prebuild": "node .local-scripts/sync-dependencies.js",
    "build": "ng build @gematik/demis-portal-core-library",
    "build:dev": "npm run clean && npm run build && npm pack dist/gematik/demis-portal-core-library --pack-destination dist",
    "build:schematics": "npm run build --prefix schematics",
    "watch": "ng build @gematik/demis-portal-core-library --watch --configuration development",
    "watch:prod": "ng build @gematik/demis-portal-core-library --watch --configuration production",
    "start": "wait-on dist/gematik/demis-portal-core-library/fesm2022/gematik-demis-portal-core-library.mjs dist/gematik/demis-portal-core-library/types/gematik-demis-portal-core-library.d.ts && ng serve --port 4299",
    "dev": "npm run build && npm-run-all --parallel watch start",
    "dev:fresh": "npm run clean && npm run build && npm-run-all --parallel watch start",
    "dev:prod": "npm run clean && npm-run-all --parallel watch:prod start",
    "test": "vitest run --coverage && npm run fix-junit-time",
    "test-local": "vitest",
    "test-local-browser": "vitest --browser.headless=false",
    "fix-junit-time": "node scripts/fix-junit-time.mjs",
    "clean-cache": "rimraf .angular/cache && echo Cache cleared - next build will be slower but clean",
    "build-fresh": "npm run clean-cache && npm run build",
    "deploy-local-dev-package": "node .local-scripts/deploy-local-dev-package.js",
    "restore-to-registry-package": "node .local-scripts/restore-to-registry-package.js"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "21.2.25",
    "@angular/cdk": "21.2.14",
    "@angular/common": "21.2.25",
    "@angular/compiler": "21.2.25",
    "@angular/core": "21.2.25",
    "@angular/forms": "21.2.25",
    "@angular/material": "21.2.14",
    "@angular/material-date-fns-adapter": "21.2.14",
    "@angular/platform-browser": "21.2.25",
    "@angular/platform-browser-dynamic": "21.2.25",
    "@angular/router": "21.2.25",
    "@ngx-formly/core": "7.1.0",
    "@ngx-formly/material": "7.1.0",
    "date-fns": "4.4.0",
    "marked": "18.1.0",
    "ngx-highlightjs": "14.0.1",
    "ngx-logger": "5.0.12",
    "ngx-mat-select-search": "8.0.6",
    "rxjs": "7.8.2",
    "tslib": "2.8.1",
    "zone.js": "0.16.3"
  },
  "devDependencies": {
    "@analogjs/vite-plugin-angular": "2.8.0",
    "@analogjs/vitest-angular": "2.8.0",
    "@angular-devkit/core": "21.2.26",
    "@angular-devkit/schematics": "21.2.26",
    "@angular/build": "21.2.26",
    "@angular/cli": "21.2.26",
    "@angular/compiler-cli": "21.2.25",
    "@types/node": "26.6.5",
    "@gematik/demis-portal-theme-library": "1.3.1",
    "@vitest/browser": "4.1.11",
    "@vitest/browser-playwright": "4.1.11",
    "@vitest/coverage-istanbul": "4.1.11",
    "core-schematics": "file:schematics",
    "jsdom": "30.1.2",
    "ng-mocks": "14.18.1",
    "ng-packagr": "21.2.7",
    "npm-run-all2": "9.0.3",
    "playwright": "1.63.0",
    "rimraf": "6.1.3",
    "typescript": "5.9.3",
    "vitest": "4.1.11",
    "wait-on": "9.5.1"
  },
  "allowScripts": {
    "@parcel/watcher@2.6.0": true,
    "esbuild@0.28.1": true,
    "esbuild@0.27.7": true,
    "lmdb@3.5.1": true,
    "msgpackr-extract@3.0.4": true
  }
}
